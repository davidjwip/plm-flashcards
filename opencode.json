{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "autoupdate": false,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "npm test*": "allow",
      "npm run *": "allow",
      "npx vitest*": "allow",
      "npx playwright*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "deny",
      "rm *": "deny",
      "sudo *": "deny"
    },
    "webfetch": "allow",
    "external_directory": "deny"
  },
  "agent": {
    "spec": {
      "description": "Writes and revises specs only. Never touches implementation.",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": {
          "*": "deny",
          "specs/**": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow"
        }
      }
    },
    "build": {
      "description": "Test-first implementation. RED before GREEN, always.",
      "mode": "primary",
      "temperature": 0.2,
      "steps": 40
    },
    "review": {
      "description": "Read-only reviewer: spec coverage, test quality, guardrails.",
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "npm test*": "allow"
        }
      }
    }
  }
}
